{
  "name": "user-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3301",
    "start:pt": "docusaurus start --port 3301",
    "start:en": "docusaurus start --locale en --port 3302",
    "start:es": "docusaurus start --locale es --port 3303",
    "build": "rm -rf build && BUILD_LOCALE=pt docusaurus build --locale pt-BR --out-dir build/pt && BUILD_LOCALE=en docusaurus build --locale en --out-dir build/en && BUILD_LOCALE=es docusaurus build --locale es --out-dir build/es && node scripts/build-landing.mjs --target build && node scripts/build-root-llms.mjs",
    "build:raw": "docusaurus build",
    "build:prod": "npm run build",
    "build:per-locale": "BUILD_LOCALE=pt docusaurus build --locale pt-BR --out-dir build-pt && BUILD_LOCALE=en docusaurus build --locale en --out-dir build-en && BUILD_LOCALE=es docusaurus build --locale es --out-dir build-es && node scripts/build-landing.mjs",
    "preview": "docusaurus build && docusaurus serve --port 3301",
    "serve:landing": "http-server build-landing -p 3300 -c-1 -s",
    "serve:pt": "http-server build-pt -p 3301 -c-1 -s",
    "serve:en": "http-server build-en -p 3302 -c-1 -s",
    "serve:es": "http-server build-es -p 3303 -c-1 -s",
    "serve:all": "concurrently -n landing,pt,en,es -c yellow,blue,green,magenta \"npm:serve:landing\" \"npm:serve:pt\" \"npm:serve:en\" \"npm:serve:es\"",
    "serve:prod": "http-server build -p 3300 -c-1 -s",
    "dev:prod": "npm run build:prod && npm run serve:prod",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "gen-manual": "node scripts/generate-manual.mjs",
    "gen-manual:check": "node scripts/generate-manual.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.88",
    "@ai-sdk/react": "^4.0.163",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@fontsource-variable/syne": "^5.2.7",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@fontsource/work-sans": "^5.2.8",
    "@mdx-js/react": "^3.0.0",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "ai": "^7.0.159",
    "clsx": "^2.0.0",
    "lucide-react": "^1.61.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "concurrently": "^10.0.3",
    "http-server": "^14.1.1",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "glob": "^13.0.0",
    "inflight": "npm:lru-cache@^11.0.0",
    "uuid": "^11.1.1",
    "js-yaml@4": "^4.3.2",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.0.5",
    "tinypool": "^2.1.2",
    "yaml@1": "^1.10.3"
  }
}
